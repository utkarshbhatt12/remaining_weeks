{
  "name": "remaining-weeks",
  "version": "1.2.0",
  "description": "A chrome extension to show remaining weeks in your life",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "rimraf dist && node scripts/prebuild.js",
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "postbuild": "cd dist && zip -r dist.zip *",
    "lint": "eslint --config eslint.config.js ./src"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.484.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/css": "^0.6.0",
    "@eslint/js": "^9.24.0",
    "@eslint/json": "^0.11.0",
    "@eslint/markdown": "^6.3.0",
    "@types/chrome": "^0.0.246",
    "@types/node": "^20.5.0",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.24.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.29.1",
    "vite": "^5.0.10"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all"
  }
}