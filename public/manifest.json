{
  "manifest_version": 3,
  "name": "Remaining Weeks",
  "description": "A chrome extension to show remaining weeks in your life",
  "version": "1.0.0",
  "icons": {
    "16": "icon16.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png"
    }
  },
  "permissions": [
    "storage",
    "topSites"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}