{
  "manifest_version": 3,
  "name": "Remaining Weeks",
  "description": "A chrome extension to show remaining weeks in your life",
  "version": "1.2.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "topSites"
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}